{
  "schemaVersion": 1,
  "invocationContract": "codex_native_agents_workflow",
  "artifactSchemaVersion": 1,
  "spawn": {
    "forkContext": false,
    "fallbackPolicy": "main_thread",
    "maxEscalations": 1,
    "forkTurns": "none"
  },
  "provenance": {
    "hostTranscriptFields": [
      "transcript_path",
      "transcriptPath"
    ],
    "subagentSessionMetaSignals": [
      "source.subagent",
      "thread_source=subagent",
      "parent_thread_id"
    ],
    "fallbackPolicy": "host_tool_isolation"
  },
  "modelProfiles": {
    "economy": {
      "model": "gpt-6-luna",
      "reasoningEffort": "low"
    },
    "balanced": {
      "model": "gpt-6-sol",
      "reasoningEffort": "medium"
    },
    "balancedHigh": {
      "model": "gpt-6-sol",
      "reasoningEffort": "high"
    },
    "frontier": {
      "model": "gpt-6-astra",
      "reasoningEffort": "xhigh"
    }
  },
  "roleProfiles": {
    "planner": "balanced",
    "implementer": "balanced",
    "researcher": "balanced",
    "reviewer": "balancedHigh",
    "final-verifier": "frontier"
  },
  "workerRoles": [
    "planner",
    "implementer",
    "researcher",
    "reviewer",
    "final-verifier"
  ],
  "reportStatusValues": [
    "DONE",
    "DONE_WITH_CONCERNS",
    "NEEDS_CONTEXT",
    "BLOCKED",
    "FAIL"
  ],
  "reportHeadings": [
    "Status",
    "Role",
    "Summary",
    "Changed Files",
    "Verification",
    "Findings",
    "Final Result",
    "Risks Or Follow-ups"
  ],
  "triggerPatterns": [
    "child[- ]?agent",
    "sub[- ]?agent",
    "child[- ]?thread",
    "sub[- ]?thread",
    "delegat(?:e|ion|ing)",
    "worker[- ]?execution",
    "\u5b50\u4ee3\u7406|\u5b50\u7ebf\u7a0b|\u591a\u4ee3\u7406|\u59d4\u6d3e|\u6d3e\u5de5|\u6267\u884c\u5c42"
  ],
  "reviewKinds": [
    "spec",
    "quality"
  ],
  "taskFile": {
    "requiredSections": [
      "Goal",
      "Allowed Scope",
      "Forbidden Actions",
      "Acceptance Criteria",
      "Verification",
      "Report Requirements"
    ],
    "sectionAliases": {
      "Goal": [
        "Goal",
        "Assignment",
        "Task"
      ],
      "Allowed Scope": [
        "Allowed Scope",
        "Scope",
        "Allowed Files"
      ],
      "Forbidden Actions": [
        "Forbidden Actions",
        "Out of Scope",
        "Forbidden Work"
      ],
      "Acceptance Criteria": [
        "Acceptance Criteria",
        "Acceptance",
        "Self Check"
      ],
      "Verification": [
        "Verification",
        "Tests",
        "Required Verification"
      ],
      "Report Requirements": [
        "Report Requirements",
        "Worker Report",
        "Output Contract"
      ]
    }
  },
  "taskEnvelope": {
    "startMarker": "[NATIVE_CODEX_AGENT_TASK]",
    "endMarker": "[/NATIVE_CODEX_AGENT_TASK]",
    "requiredFields": [
      "WorkflowId",
      "TaskId",
      "Role",
      "TaskFile",
      "Scope",
      "ModelProfile",
      "Writable",
      "Parallel",
      "DispatcherRole"
    ]
  }
}
